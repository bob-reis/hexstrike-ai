# 🎭 TRINITY INTEGRATION - Villager AI Configuration
# ==============================================
# This file integrates Villager AI with the Trinity Pentest Orchestrator

# 🔐 Load secrets from centralized Trinity configuration
source /opt/trinity-secrets/.env

# ========================================
# 🎯 VILLAGER AI SPECIFIC SETTINGS
# ========================================

# LLM Provider (inherit from Trinity but allow override)
LLM_PROVIDER=${LLM_PROVIDER:-openai}

# OpenAI Configuration (use Trinity keys)
OPENAI_API_KEY=${OPENAI_API_KEY}

# DeepSeek Configuration (use Trinity keys)
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama Configuration (use Trinity settings)
OLLAMA_BASE_URL=${OLLAMA_BASE_URL:-http://localhost:11434}
OLLAMA_MODEL=${OLLAMA_MODEL:-deepseek-r1-uncensored}

# ========================================
# 🎭 VILLAGER SERVICE CONFIGURATION
# ========================================

# Core Villager Server
VILLAGER_BASE_URL=http://127.0.0.1:37695
VILLAGER_HOST=0.0.0.0
VILLAGER_PORT=37695

# MCP Client Service
MCP_CLIENT_BASE_URL=http://localhost:25989
MCP_CLIENT_PORT=${VILLAGER_MCP_PORT:-25989}
MCP_CLIENT_HOST=0.0.0.0

# Kali Driver Service
KALI_DRIVER_PORT=${VILLAGER_KALI_PORT:-1611}
KALI_DRIVER_HOST=0.0.0.0

# Browser Automation Service
BROWSER_SERVICE_PORT=${VILLAGER_BROWSER_PORT:-8080}
BROWSER_SERVICE_HOST=0.0.0.0

# ========================================
# 🔗 TRINITY INTEGRATION SETTINGS
# ========================================

# HexStrike Integration
HEXSTRIKE_BASE_URL=${HEXSTRIKE_SERVER_URL:-http://127.0.0.1:8888}

# PentestGPT Integration
PENTESTGPT_PATH=${PENTESTGPT_PATH:-/opt/PentestGPT}

# Trinity Workspace
TRINITY_WORKSPACE=${TRINITY_WORKSPACE:-/opt/trinity-pentest/workspace}
TRINITY_LOG_DIR=${TRINITY_LOG_DIR:-/opt/trinity-pentest/logs}

# ========================================
# 🛡️ SECURITY SETTINGS
# ========================================

# Allow advanced operations (required for pentesting)
ALLOW_SHELL=1  # Direct command shell execution
ALLOW_APT=1    # Package management (tools installation)
ALLOW_WRITE=1  # Filesystem write access
ALLOW_BUILD=1  # Build operations (compilation, Docker)

# Security limits (inherit from Trinity)
MAX_CONCURRENT_TASKS=${MAX_CONCURRENT_TASKS:-5}
RATE_LIMIT_REQUESTS=${RATE_LIMIT_REQUESTS:-100}
RATE_LIMIT_WINDOW=${RATE_LIMIT_WINDOW:-3600}

# ========================================
# 🐳 DOCKER & CONTAINER SETTINGS
# ========================================

# Kali Linux Docker Configuration
KALI_IMAGE=${KALI_IMAGE:-kalilinux/kali-rolling}
CONTAINER_TIMEOUT=${CONTAINER_TIMEOUT:-86400}  # 24 hours
CONTAINER_NAME_PREFIX=trinity-villager-kali

# Docker network (inherit from Trinity)
DOCKER_NETWORK=${DOCKER_NETWORK:-bridge}

# ========================================
# 📊 LOGGING & MONITORING
# ========================================

# Logging Configuration
LOG_LEVEL=${LOG_LEVEL:-INFO}
LOG_FILE=villager.log
LOG_DIR=${VILLAGER_PATH}/logs
PYTHONUNBUFFERED=1

# Trinity integration logging
TRINITY_INTEGRATION=true
ENABLE_TRINITY_LOGGING=true

# ========================================
# 🎯 FEATURE TOGGLES
# ========================================

# Enable/disable specific features
ENABLE_KALI_CONTAINERS=true
ENABLE_BROWSER_AUTOMATION=true
ENABLE_MCP_CLIENT=true
ENABLE_HEXSTRIKE_INTEGRATION=true
ENABLE_PENTESTGPT_INTEGRATION=true

# Trinity orchestration features
AUTO_CORRELATION=${AUTO_CORRELATION:-true}
SMART_TOOL_SELECTION=${SMART_TOOL_SELECTION:-true}
ADAPTIVE_STRATEGY=${ADAPTIVE_STRATEGY:-true}

# ========================================
# 🌐 NETWORK & SCANNING SETTINGS
# ========================================

# Scanning timeouts (inherit from Trinity)
NMAP_TIMEOUT=${NMAP_TIMEOUT:-1800}
NUCLEI_TIMEOUT=${NUCLEI_TIMEOUT:-3600}
GOBUSTER_TIMEOUT=${GOBUSTER_TIMEOUT:-1800}

# Rate limiting for external tools
SCAN_DELAY=${SCAN_DELAY:-0.1}
MAX_THREADS=${MAX_THREADS:-50}

# ========================================
# 🎭 VILLAGER-SPECIFIC ENHANCEMENTS
# ========================================

# Task decomposition settings
MAX_TASK_DEPTH=5
TASK_TIMEOUT=3600  # 1 hour per task

# AI reasoning settings
ENABLE_UNCENSORED_REASONING=true
CONTEXT_MEMORY_SIZE=10000
ENABLE_CHAIN_OF_THOUGHT=true

# Container lifecycle
CONTAINER_AUTO_CLEANUP=true
CONTAINER_HEALTH_CHECK_INTERVAL=300  # 5 minutes